uploads/
jobs/
build/
*.log
.env
.env.*
!**/.env.example

# Frame dumps: pipeline PNG output is hundreds of megabytes and is never committed.
# Published video and charts under assets/ are checked in deliberately.
*.png
!assets/charts/*.png
!assets/timeline/*.png

.DS_Store
