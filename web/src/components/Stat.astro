---
interface Props {
  value: string;
  label: string;
  tone?: "default" | "accent" | "warn" | "kept";
}

const { value, label, tone = "default" } = Astro.props;

const toneClass = {
  default: "text-ink",
  accent: "text-accent",
  warn: "text-dropped",
  kept: "text-kept",
}[tone];
---

<div class="border border-line bg-panel px-4 py-3">
  <div class={`font-mono text-2xl font-medium tracking-tight sm:text-[1.65rem] ${toneClass}`}>{value}</div>
  <div class="mt-1 text-[12px] leading-snug text-muted">{label}</div>
</div>
