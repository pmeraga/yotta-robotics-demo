---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { id, eyebrow, title, lede } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl scroll-mt-16 px-5 py-14 sm:px-6 sm:py-16">
  {
    eyebrow && (
      <p class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-accent">{eyebrow}</p>
    )
  }
  <h2 class="mt-2 max-w-3xl text-2xl font-semibold tracking-tight text-ink sm:text-[1.75rem]">{title}</h2>
  {lede && <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-muted">{lede}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>
