---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { id, eyebrow, title, lede } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl scroll-mt-20 px-6 py-16 sm:py-20">
  {
    eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
    )
  }
  <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
  {lede && <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-muted">{lede}</p>}
  <div class="mt-10">
    <slot />
  </div>
</section>
