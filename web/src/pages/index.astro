---
import { asset } from "../lib/url";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import UploadPanel from "../components/UploadPanel.astro";
import stats from "../../../data/stats.json";
import datasets from "../../../data/datasets.json";

const { dataset, episodes, totals, throughput } = stats;
const headline = totals.policies.include_recovery;
const successOnly = totals.policies.success_only;
const dedupOnly = totals.policies.dedup_only;
const label = episodes[0].original_label;
const endToEnd = throughput.stages.find((s) => s.label === "End to end (fast visual)")!.fps;
const idleTail = episodes.reduce((sum, e) => sum + e.idle_tail_frames, 0);
const sourceMb = (totals.source_bytes / (1024 * 1024)).toFixed(0);
const curatedMb = (totals.curated_bytes / (1024 * 1024)).toFixed(1);

const fitLabel: Record<string, string> = {
  high: "Best fit",
  medium: "Needs convert",
  shipped: "On this site",
};
---

<BaseLayout
  title="Yotta — curation for robot & AV training data"
  description="Robot episodes are labelled as clean demonstrations but contain failures, recoveries, and dead time. Yotta reconstructs what actually happened and cuts the dataset down to what is worth training on."
>
  <!-- Hero: brand + one claim + one visual -->
  <section class="border-b border-line bg-panel">
    <div class="mx-auto grid max-w-6xl gap-0 lg:grid-cols-2">
      <div class="flex flex-col justify-center border-b border-line px-5 py-12 sm:px-6 sm:py-16 lg:border-b-0 lg:border-r">
        <img
          src={asset("/brand-wordmark.svg")}
          alt="Yotta"
          class="h-10 w-auto self-start sm:h-12"
        />
        <h1 class="mt-8 text-3xl font-semibold leading-[1.15] tracking-tight text-ink sm:text-4xl">
          Your labels say success. The footage says otherwise.
        </h1>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted">
          We reconstruct attempts, recoveries, and idle tails from LeRobot episodes —
          then cut training sets to what is actually worth learning from.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#try"
            class="border border-ink bg-ink px-4 py-2.5 text-sm font-medium text-panel hover:border-accent hover:bg-accent"
          >
            Run on your clip
          </a>
          <a
            href="#results"
            class="border border-line bg-panel px-4 py-2.5 text-sm font-medium text-ink hover:border-ink"
          >
            Measured results
          </a>
        </div>
      </div>
      <div class="relative bg-ink">
        <video
          class="aspect-video h-full w-full object-cover"
          src={asset("/assets/video/annotated_ep0.mp4")}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        ></video>
        <p class="absolute bottom-0 left-0 right-0 border-t border-line/40 bg-ink/90 px-4 py-2 font-mono text-[11px] text-panel">
          ep0 annotated · green = kept · red = dropped · {episodes[0].percent_reduced}% removed
        </p>
      </div>
    </div>
  </section>

  <!-- KPI strip -->
  <section class="border-b border-line bg-paper">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-line sm:grid-cols-4">
      <div class="bg-paper p-1">
        <Stat value={`${totals.episodes_with_hidden_failures}/${totals.episodes}`} label="Episodes with hidden failure" tone="warn" />
      </div>
      <div class="bg-paper p-1">
        <Stat value={`${headline.percent_reduced}%`} label="Frames cut (full task arc)" tone="kept" />
      </div>
      <div class="bg-paper p-1">
        <Stat value={`${successOnly.percent_reduced}%`} label="Cut if success-only" tone="accent" />
      </div>
      <div class="bg-paper p-1">
        <Stat value={`${endToEnd}`} label="fps end-to-end (laptop CPU)" />
      </div>
    </div>
  </section>

  <Section
    eyebrow="01 — The problem"
    title={`Every frame labelled “${label}”`}
    lede="A single task string is stamped across the whole episode. Failures, re-grasps, and post-success idle look like good demonstrations to any model trained on the raw labels."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <img
        src={asset("/assets/charts/phase_composition.png")}
        alt="Stacked bars showing each episode broken into attempts, recoveries, success, and idle"
        class="w-full border border-line bg-panel"
        loading="lazy"
      />
      <div class="space-y-0 border border-line bg-panel">
        <div class="border-b border-line px-5 py-4">
          <p class="font-mono text-[11px] uppercase tracking-wide text-dropped">Label on disk</p>
          <p class="mt-1 text-[15px] font-medium text-ink">“{label}”</p>
          <p class="mt-1 text-[13px] text-muted">Applied to all {episodes[0].total_frames} frames of episode 0.</p>
        </div>
        <div class="px-5 py-4">
          <p class="font-mono text-[11px] uppercase tracking-wide text-kept">Structure recovered</p>
          <ul class="mt-2 space-y-2 text-[14px] leading-snug text-muted">
            <li>Failed attempt → recovery → failed attempt → recovery → success.</li>
            <li>{idleTail} idle-tail frames across 3 episodes after the task was done.</li>
            <li>{sourceMb} MB source → {curatedMb} MB curated under “full task arc”.</li>
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section
    id="results"
    eyebrow="02 — Measured results"
    title={`${totals.total_frames.toLocaleString()} frames · 3 episodes · every cut auditable`}
    lede="Annotated videos show keep/drop per frame. Phase rows below are the same numbers the pipeline writes to sidecars."
  >
    <div class="overflow-x-auto border border-line bg-panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Episode</th>
            <th>Frames</th>
            <th>Kept</th>
            <th>Dropped</th>
            <th>Reduced</th>
            <th>Attempts</th>
            <th>Recoveries</th>
            <th>Idle tail</th>
            <th>Source → curated</th>
          </tr>
        </thead>
        <tbody>
          {
            episodes.map((ep) => (
              <tr>
                <td class="num">ep{ep.index}</td>
                <td class="num">{ep.total_frames}</td>
                <td class="num">{ep.kept_frames}</td>
                <td class="num">{ep.dropped_frames}</td>
                <td class="num">{ep.percent_reduced}%</td>
                <td class="num">{ep.attempts}</td>
                <td class="num">{ep.recoveries}</td>
                <td class="num">{ep.idle_tail_frames}</td>
                <td class="num">
                  {(ep.source_bytes / (1024 * 1024)).toFixed(1)} → {(ep.curated_bytes / (1024 * 1024)).toFixed(1)} MB
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {episodes.map((episode) => <EpisodeCard episode={episode} />)}
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <figure class="border border-line bg-panel">
        <img
          src={asset("/assets/charts/kept_vs_dropped.png")}
          alt="Kept versus dropped frames per episode"
          class="w-full"
          loading="lazy"
        />
        <figcaption class="border-t border-line px-4 py-2 font-mono text-[11px] text-muted">
          kept_vs_dropped.png · include_recovery policy
        </figcaption>
      </figure>
      <figure class="border border-line bg-panel">
        <img
          src={asset("/assets/charts/throughput.png")}
          alt="Pipeline throughput by stage"
          class="w-full"
          loading="lazy"
        />
        <figcaption class="border-t border-line px-4 py-2 font-mono text-[11px] text-muted">
          throughput.png · {throughput.hardware}
        </figcaption>
      </figure>
    </div>

    <div class="mt-6 overflow-x-auto border border-line bg-panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Stage</th>
            <th>FPS</th>
            <th>Embedder</th>
          </tr>
        </thead>
        <tbody>
          {
            throughput.stages.map((s) => (
              <tr>
                <td>{s.label}</td>
                <td class="num">{s.fps}</td>
                <td class="num">{s.embedder}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-[13px] text-muted">
      Full {dataset.total_frames.toLocaleString()}-frame dataset ≈ {Math.round(throughput.full_dataset_sec / 60)} min
      single-threaded on {throughput.hardware}. Source:{" "}
      <a class="text-accent underline-offset-2 hover:underline" href={dataset.url}>{dataset.name}</a>
      · camera {dataset.camera} · {dataset.fps} fps · {dataset.total_episodes} episodes.
    </p>
  </Section>

  <Section
    id="policies"
    eyebrow="03 — Policies"
    title="Same footage, three training goals"
    lede="Curation is an input. What counts as redundant depends on whether you need recoveries for robustness or only clean successes for imitation."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <img
        src={asset("/assets/charts/policy_comparison.png")}
        alt="Frames kept under three curation policies"
        class="w-full border border-line bg-panel"
        loading="lazy"
      />
      <div class="border border-line bg-panel divide-y divide-line">
        {
          [
            {
              name: dedupOnly.label,
              kept: dedupOnly.kept_frames,
              pct: dedupOnly.percent_reduced,
              body: "Remove visual redundancy only. Task structure unchanged — safe default when the training goal is still unclear.",
            },
            {
              name: headline.label,
              kept: headline.kept_frames,
              pct: headline.percent_reduced,
              body: "Keep failures and recoveries; drop post-success idle. Policies that never see a drop cannot learn to recover.",
            },
            {
              name: successOnly.label,
              kept: successOnly.kept_frames,
              pct: successOnly.percent_reduced,
              body: "Keep only the attempt that worked. Aggressive cut for clean imitation — where most storage savings live.",
            },
          ].map((policy) => (
            <div class="px-5 py-4">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-[15px] font-semibold text-ink">{policy.name}</h3>
                <span class="font-mono text-[13px] text-accent">
                  {policy.kept}f · −{policy.pct}%
                </span>
              </div>
              <p class="mt-1.5 text-[14px] leading-relaxed text-muted">{policy.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section
    id="datasets"
    eyebrow="04 — Open datasets"
    title="Where to point the pipeline next"
    lede="Manipulation demo is shipped. For autonomous driving, start with LeRobot-native L2D — then convert comma2k19 / nuScenes if you need more diversity."
  >
    <div class="overflow-x-auto border border-line bg-panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fit</th>
            <th>Dataset</th>
            <th>Format</th>
            <th>Domain</th>
            <th>Scale</th>
            <th>Why</th>
          </tr>
        </thead>
        <tbody>
          {
            datasets.candidates.map((d) => (
              <tr>
                <td>
                  <span class="font-mono text-[11px] uppercase tracking-wide text-accent">
                    {fitLabel[d.fit] ?? d.fit}
                  </span>
                </td>
                <td>
                  <a class="font-medium text-ink underline-offset-2 hover:text-accent hover:underline" href={d.url}>
                    {d.name}
                  </a>
                  {d.blog && (
                    <p class="mt-1">
                      <a class="text-[12px] text-accent hover:underline" href={d.blog}>
                        HF blog
                      </a>
                    </p>
                  )}
                </td>
                <td class="num">{d.format}</td>
                <td>{d.domain}</td>
                <td>{d.scale}</td>
                <td class="max-w-xs text-muted">{d.why}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-[13px] text-muted">
      Recommended first AV pull: stream a small L2D revision with{" "}
      <code class="font-mono text-[12px] text-ink">StreamingLeRobotDataset("yaak-ai/L2D")</code>,
      run quality + event detection, then scale. See{" "}
      <a class="text-accent underline-offset-2 hover:underline" href="https://huggingface.co/blog/lerobot-goes-to-driving-school"
        >LeRobot goes to driving school</a
      >.
    </p>
  </Section>

  <Section
    id="try"
    eyebrow="05 — Live demo"
    title="Run the pipeline on your own clip"
    lede="Upload a short robot episode. You get failure/recovery detection, proposed phase labels, lighting/freeze QA, and a curated cut. Uploads and results are deleted about an hour after processing."
  >
    <UploadPanel />
  </Section>

  <Section
    eyebrow="06 — Pipeline"
    title="Nine stages, adoptable one at a time"
    lede="Each stage writes a sidecar next to the untouched recording — adopt one gate without buying the whole stack."
  >
    <ol class="border border-line bg-panel divide-y divide-line">
      {
        [
          ["Ingest and normalize", "HF datasets → reviewable timeline of trajectories + camera."],
          ["Label scaffolding", "Time-ranged annotation templates beside immutable recordings."],
          ["Action-state inference", "Open-vocabulary metadata over frame windows."],
          ["Geometry enrichment", "Depth / normals / segmentation sidecars."],
          ["Quality assessment", "Exemplar retrieval, defect gates, trajectory matching."],
          ["Frame curation", "Visual drift + kinematics so real motion is not treated as redundancy."],
          ["Failure detection", "Drops, re-grasps, backtracks, post-success idle — no per-frame labels required."],
          ["Annotation QA", "Flag lying labels; propose corrected phase spans."],
          ["Training handoff", "Pruned datasets, curated video, lossless state/action round-trip."],
        ].map(([name, body], i) => (
          <li class="grid gap-1 px-5 py-3.5 sm:grid-cols-[3rem_12rem_1fr] sm:items-baseline sm:gap-4">
            <span class="font-mono text-[12px] text-accent">{String(i + 1).padStart(2, "0")}</span>
            <span class="text-[14px] font-semibold text-ink">{name}</span>
            <span class="text-[13px] text-muted">{body}</span>
          </li>
        ))
      }
    </ol>
  </Section>
</BaseLayout>
